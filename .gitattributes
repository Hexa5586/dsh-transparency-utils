# Normalize line endings in the repository so a Git install checks out the same
# bytes on every platform.
* text=auto

*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary assets are never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.avif binary
*.ico binary
